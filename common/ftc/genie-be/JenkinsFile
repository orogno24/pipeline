pipeline {
    agent {
        kubernetes {
            label 'dind-ftc'
        }
    }

    environment {
        APP_NAME = 'genie-us-be'
        GIT_BRANCH_NAME = 'main'
        GITEA_OWNER = 'afterloan'
    }

    stages {
        stage('Webhook Info') {
            steps {
                echo "Webhook received"
                echo "ref = ${env.ref}"
                echo "after = ${env.after}"
                echo "APP_NAME = ${env.APP_NAME}"
            }
        }

        stage('Checkout main') {
            steps {
                dir('source') {
                    git branch: "${env.GIT_BRANCH_NAME}",
                        url: "http://gitea-http:3000/${env.GITEA_OWNER}/${env.APP_NAME}.git",
                        credentialsId: 'gitea-credentials'
                }
            }
        }

        stage('Load and Run') {
            steps {
                script {
                    def core = load 'common/core.groovy'
                    core.transferSourceArchiveToFtc('source', env.APP_NAME, env.GIT_BRANCH_NAME)
                }
            }
        }
    }
}