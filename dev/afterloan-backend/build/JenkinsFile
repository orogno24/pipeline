def core

pipeline {
    agent {
        kubernetes {
            label 'dind-gradle'
        }
    }

    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'ref', value: '$.ref'],
                [key: 'after', value: '$.after'],
                [key: 'before', value: '$.before'],
                [key: 'repository', value: '$.repository.full_name'],
                [key: 'pusher', value: '$.pusher.username']
            ],
            causeString: 'Triggered on $ref by $pusher',
            token: 'genie-us-dev-be-token',
            printContributedVariables: true,
            printPostContent: true,
            regexpFilterText: '$ref',
            regexpFilterExpression: '^refs/heads/dev$'
        )
    }

    environment {
        BUILD_TOOL = 'gradle'
        REDMINE_URL = 'http://redmine.cicd.svc.cluster.local'

        SONAR_HOST_URL = 'http://sonarqube-sonarqube.cicd.svc.cluster.local:9000'
        SONAR_PROJECT_KEY = 'genie-us-be'
        SONAR_PROJECT_NAME = 'genie-us-be'

        // ── Git 소스 (모노레포) ───────────────────────────────────────
        GIT_URL = 'http://gitea-http:3000/it-department/Genie-us.git'
        GIT_CREDENTIALS_ID = 'gitea-credentials'
        GIT_BRANCH = 'dev'

        // ── GitOps 레포 (ArgoCD) ──────────────────────────────────────
        GITOPS_URL = 'http://gitea-http:3000/Gitops/kustomize.git'
        GITOPS_PATH = 'gitea-http:3000/Gitops/kustomize.git'
        GITOPS_API_URL = 'http://gitea-http:3000/api/v1/repos/Gitops/kustomize'
        GITOPS_CREDENTIALS_ID = 'gitea-credentials'
        GITOPS_BRANCH = 'main'
        GITOPS_DIR = 'genie-us-be/overlay/dev'
        GITOPS_CONTAINER_NAME = 'genie-us-be'

        // ── Harbor 이미지 ─────────────────────────────────────────────
        DOCKER_REGISTRY_URL = 'harbor-core:80'
        DOCKER_REGISTRY_URL_OPS = 'harbor.jtchinae-bank.co.kr'
        DOCKER_PROJECT_NAME = 'jtcsb'
        DOCKER_IMAGE_NAME = 'jtcsb/genie-us-be'
        DOCKER_REPO_NAME = 'genie-us-be'
        DOCKER_IMAGE_URL = 'harbor.jtchinae-bank.co.kr/jtcsb/genie-us-be'
        DOCKER_REGISTRY_CREDENTIALS_ID = 'harbor-jtcsb-credentials'

        // ── 소스 체크아웃 위치 / 빌드 경로 ─────────────────────────────
        SOURCE_DIR = 'source'
        BUILD_CONTEXT = 'source/back-common'

        SKIP_BUILD = 'false'
    }

    stages {
        stage('Init') {
            steps {
                script {
                    core = load 'common/core.groovy'
                }
            }
        }

        stage('Webhook Info') {
            steps {
                echo "Webhook received"
                echo "ref = ${env.ref}"
                echo "before = ${env.before}"
                echo "after = ${env.after}"
                echo "repository = ${env.repository}"
                echo "pusher = ${env.pusher}"
            }
        }

        stage('Checkout') {
            steps {
                dir(env.SOURCE_DIR) {
                    script {
                        core.checkout()
                    }
                }
            }
        }

        stage('Detect Changes') {
            steps {
                dir(env.SOURCE_DIR) {
                    script {
                        // 수동 실행이면 webhook payload 값이 없으므로 변경 감지 스킵
                        if (!env.after?.trim() || env.after == 'null') {
                            echo "Webhook 변수가 없어 변경 파일 감지를 생략합니다. 수동 실행으로 간주합니다."
                            env.SKIP_BUILD = 'false'
                            return
                        }

                        def changedFiles = ''

                        if (env.before?.trim() && env.before != 'null' && !env.before.startsWith('0000000')) {
                            changedFiles = sh(
                                script: "git diff --name-only ${env.before} ${env.after} || true",
                                returnStdout: true
                            ).trim()
                        } else {
                            changedFiles = sh(
                                script: "git diff-tree --no-commit-id --name-only -r ${env.after} || true",
                                returnStdout: true
                            ).trim()
                        }

                        echo "Changed files:\n${changedFiles}"

                        if (!changedFiles) {
                            env.SKIP_BUILD = 'true'
                        } else {
                            def backendChanged = changedFiles.split('\n').any { it.startsWith('back-common/') }
                            env.SKIP_BUILD = backendChanged ? 'false' : 'true'
                        }

                        echo "SKIP_BUILD = ${env.SKIP_BUILD}"
                    }
                }
            }
        }

        stage('Load and Run') {
            when {
                expression { env.SKIP_BUILD != 'true' }
            }
            steps {
                script {
                    core.notifyRedmine("START")

                    container('gradle') {
                        dir(env.BUILD_CONTEXT) {
                            core.build()
                            core.sonarAnalysis()
                            core.sonarAnalysisResult()
                        }
                    }

                    container('docker-dind') {
                        dir(env.BUILD_CONTEXT) {
                            core.dockerBuild()
                        }
                        core.dockerPush()
                    }

                    core.gitOpsDeploy()
                    core.notifyRedmine("SUCCESS")
                }
            }
        }

        stage('Skip Info') {
            when {
                expression { env.SKIP_BUILD == 'true' }
            }
            steps {
                echo "front/ 경로 변경이 없어 프론트 파이프라인을 생략합니다."
            }
        }
    }

    post {
        failure {
            script {
                if (core != null) {
                    core.notifyRedmine("FAIL")
                } else {
                    echo "core.groovy 가 로드되지 않아 FAIL 알림을 생략합니다."
                }
            }
        }
    }
}