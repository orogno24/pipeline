pipeline {
    agent {
        kubernetes {
            label 'dind'
        }
    }

    environment {
        BUILD_TOOL = 'gradle'

        SONAR_HOST_URL = 'http://sonarqube-sonarqube.cicd.svc.cluster.local:9000'
        SONAR_PROJECT_KEY = 'afterloan-be'
        SONAR_PROJECT_NAME = 'afterloan-be'

        // ── Git 소스 ─────────────────────────────────────────────────
        GIT_URL = 'http://gitea-http:3000/afterloan/afterloan-be.git'
        GIT_CREDENTIALS_ID = 'gitea-credentials'
        GIT_BRANCH = 'main'

        // ── GitOps 레포 (ArgoCD) ──────────────────────────────────────
        GITOPS_URL = 'http://gitea-http:3000/Gitops/kustomize.git'
        GITOPS_PATH = 'gitea-http:3000/Gitops/kustomize.git'
        GITOPS_API_URL = 'http://gitea-http:3000/api/v1/repos/Gitops/kustomize.git'
        GITOPS_CREDENTIALS_ID = 'gitea-credentials'
        GITOPS_BRANCH = 'main'
        GITOPS_DIR = 'afterloan-be/overlay/dev'
        GITOPS_CONTAINER_NAME = 'afterloan-be'

        // ── Harbor 이미지 ─────────────────────────────────────────────
        DOCKER_REGISTRY_URL = 'harbor-core:80'
        DOCKER_REGISTRY_URL_OPS = 'harbor.dev.jtcsb.co.kr'
        DOCKER_PROJECT_NAME = 'jtcsb'
        DOCKER_IMAGE_NAME = 'jtcsb/afterloan-be'
