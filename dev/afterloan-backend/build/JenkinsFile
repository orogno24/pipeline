        // ── 모노레포 내 빌드 경로 ─────────────────────────────────────
        BUILD_CONTEXT = '.'
    }

    stages {
        stage('Webhook Info') {
            steps {
                echo "Webhook received"
                echo "ref = ${env.ref}"
                echo "after = ${env.after}"
            }
        }

        stage('Load and Run') {
            steps {
                script {
                    def core = load 'common/core-webhook.groovy'
                    core.checkout()
