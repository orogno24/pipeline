pipeline {
    agent {
        kubernetes {
            label 'dind-gradle'
        }
    }

    environment {
        BUILD_TOOL = 'gradle'
        REDMINE_URL = 'http://redmine.cicd.svc.cluster.local'

        SONAR_HOST_URL = 'http://sonarqube-sonarqube.cicd.svc.cluster.local:9000'
        SONAR_PROJECT_KEY = 'genie-us-fe'
        SONAR_PROJECT_NAME = 'genie-us-fe'

        // ── Git 소스 (모노레포) ───────────────────────────────────────
        GIT_URL = 'http://gitea-http:3000/it-department/Genie-us.git'
        GIT_CREDENTIALS_ID = 'gitea-credentials'
        GIT_BRANCH = 'main'

        // ── GitOps 레포 (ArgoCD) ──────────────────────────────────────
        GITOPS_URL = 'http://gitea-http:3000/Gitops/kustomize.git'
        GITOPS_PATH = 'gitea-http:3000/Gitops/kustomize.git'
        GITOPS_API_URL = 'http://gitea-http:3000/api/v1/repos/Gitops/kustomize'
        GITOPS_CREDENTIALS_ID = 'gitea-credentials'
        GITOPS_BRANCH = 'main'
        GITOPS_DIR = 'genie-us-fe/overlay/dev'
        GITOPS_CONTAINER_NAME = 'genie-us-fe'

        // ── Harbor 이미지 ─────────────────────────────────────────────
        DOCKER_REGISTRY_URL = 'harbor-core:80'
        DOCKER_REGISTRY_URL_OPS = 'harbor.jtchinae-bank.co.kr'
        DOCKER_PROJECT_NAME = 'jtcsb'
        DOCKER_IMAGE_NAME = 'jtcsb/genie-us-fe'
        DOCKER_REPO_NAME = 'genie-us-fe'
        DOCKER_IMAGE_URL = 'harbor.jtchinae-bank.co.kr/jtcsb/genie-us-fe'
        DOCKER_REGISTRY_CREDENTIALS_ID = 'harbor-jtcsb-credentials'

        // ── 모노레포 내 프론트 빌드 경로 ───────────────────────────────
        BUILD_CONTEXT = 'front'
    }

    stages {
        stage('Webhook Info') {
            steps {
                echo "Webhook received"
                echo "ref = ${env.ref}"
                echo "after = ${env.after}"
            }
        }

        stage('Load and Run') {
            steps {
                script {
                    def core = load 'common/core.groovy'

                    // 모노레포 전체 checkout
                    core.checkout()
                    core.notifyRedmine("START")

                    // 1. 빌드 및 품질 분석
                    container('gradle') {
                        dir(env.BUILD_CONTEXT) {
                            core.build()
                            core.sonarAnalysis()
                            core.sonarAnalysisResult()
                        }
                    }

                    // 2. 도커 이미지 빌드 및 푸시
                    container('docker-dind') {
                        dir(env.BUILD_CONTEXT) {
                            core.dockerBuild()
                        }
                        core.dockerPush()
                    }

                    // 3. GitOps 배포 설정 업데이트
                    core.gitOpsDeploy()
                    core.notifyRedmine("SUCCESS")
                }
            }
        }
    }

    post {
        failure {
            script {
                def core = load 'common/core.groovy'
                core.notifyRedmine("FAIL")
            }
        }
    }
}