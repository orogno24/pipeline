pipeline {
   triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'PR_ACTION',   value: '$.action'],
                [key: 'PR_TO',       value: '$.pull_request.base.label'],
                [key: 'PR_HEAD_SHA', value: '$.pull_request.head.sha'],
                [key: 'REPO_NAME',   value: '$.repository.name'],
                [key: 'PR_NUMBER',   value: '$.number']
            ],
            causeString: 'subbranch→dev PR #$PR_NUMBER',
            token: 'build-deploy-token',
            regexpFilterText: '$PR_ACTION__$PR_TO',
            regexpFilterExpression: 'opened__dev'
        )
    }

    agent {
        kubernetes {
            label 'dind'
        }
    }

    tools {
        jdk 'jdk-17'
    }

    environment {
        BUILD_TOOL                     = 'gradle'

        SONAR_HOST_URL = 'http://sonarqube-sonarqube.cicd.svc.cluster.local:9000'
        SONAR_PROJECT_KEY = 'afterloan-fe'
        SONAR_PROJECT_NAME = 'afterloan-fe'

        // ── Git 소스 ─────────────────────────────────────────────────
        GIT_URL                        = 'http://gitea-http:3000/afterloan/afterloan-fe.git'
        GIT_CREDENTIALS_ID             = 'gitea-credentials'
        GIT_BRANCH                     = 'main'

        // ── GitOps 레포 (ArgoCD) ──────────────────────────────────────
        GITOPS_URL                     = 'http://gitea-http:3000/Gitops/kustomize.git'
        GITOPS_PATH                    = 'gitea-http:3000/Gitops/kustomize.git'
        GITOPS_API_URL                 = 'http://gitea-http:3000/api/v1/repos/Gitops/kustomize.git'
        GITOPS_CREDENTIALS_ID          = 'gitea-credentials'
        GITOPS_BRANCH                  = 'main'
        GITOPS_DIR                     = 'afterloan-fe/overlay/dev'
        GITOPS_CONTAINER_NAME          = 'afterloan-fe'

        // ── Harbor 이미지 ─────────────────────────────────────────────
        DOCKER_REGISTRY_URL            = 'harbor-core:80'
        DOCKER_REGISTRY_URL_OPS        = 'harbor.dev.jtcsb.co.kr'
        DOCKER_PROJECT_NAME            = 'msaproject'
        DOCKER_IMAGE_NAME              = 'msaproject/afterloan-fe'
        DOCKER_REPO_NAME               = 'afterloan-fe'
        DOCKER_IMAGE_URL               = 'harbor.dev.jtcsb.co.kr/msaproject/afterloan-fe'
        DOCKER_REGISTRY_CREDENTIALS_ID = 'harbor-credentials'

        // ── 모노레포 내 빌드 경로 ─────────────────────────────────────
        BUILD_CONTEXT                  = 'afterloan-fe'
    }

    stages {
        stage('Load and Run') {
            steps {
                script {
                    def core = load 'common/core.groovy'
                    core.checkTag(env.REPO_NAME, env.PR_HEAD_SHA)
                    core.mergePR(env.REPO_NAME, env.PR_NUMBER)
                    core.checkout()
                    core.notifyRedmine("START")
                    dir(env.BUILD_CONTEXT) {
                        core.dockerBuild()
                    }
                    core.dockerPush()
                    core.harborImageScan()
                    core.gitOpsDeploy()
                    core.notifyRedmine("SUCCESS")
                }
            }
        }
    }
    post {
        success { echo "파이프라인 완료" }
        failure { echo "파이프라인 실패" }
    }
}