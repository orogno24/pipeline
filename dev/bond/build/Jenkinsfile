pipeline {
    parameters {
        gitParameter(
            name: 'SELECTED_TAG',
            description: '배포할 Git 태그를 선택하세요',
            type: 'PT_TAG',
            branch: 'main',
            branchFilter: 'origin/(.*)',
            defaultValue: 'latest',
            useRepository: 'http://gitea-http:3000/genie/bond.git',
            sortMode: 'DESCENDING_SMART'
        )
        choice(
            name: 'BUILD_TOOL',
            choices: ['gradle', 'maven'],
            description: '빌드 도구를 선택하세요 (gradle 또는 maven)'
        )
    }

    agent {
        kubernetes {
            label 'dind'
        }
    }

    tools {
        jdk 'jdk-17'
    }

    environment {
        SONAR_HOST_URL = 'http://sonarqube-sonarqube.cicd.svc.cluster.local:9000'
        SONAR_PROJECT_KEY = 'bond'
        SONAR_PROJECT_NAME = 'bond'

        // ── Git 소스 ─────────────────────────────────────────────────
        GIT_URL                        = 'http://gitea-http:3000/genie/bond.git'
        GIT_CREDENTIALS_ID             = 'gitea-credentials'
        GIT_BRANCH                     = 'main'

        // ── GitOps 레포 (ArgoCD) ──────────────────────────────────────
        GITOPS_URL                     = 'http://gitea-http:3000/Gitops/kustomize.git'
        GITOPS_PATH                    = 'gitea-http:3000/Gitops/kustomize.git'
        GITOPS_API_URL                 = 'http://gitea-http:3000/api/v1/repos/Gitops/kustomize.git'
        GITOPS_CREDENTIALS_ID          = 'gitea-credentials'
        GITOPS_BRANCH                  = 'main'
        GITOPS_DIR                     = 'bond/overlay/dev'
        GITOPS_CONTAINER_NAME          = 'bond'

        // ── Harbor 이미지 ─────────────────────────────────────────────
        DOCKER_REGISTRY_URL            = 'harbor-core:80'
        DOCKER_REGISTRY_URL_OPS        = 'harbor.dev.jtcsb.co.kr'
        DOCKER_PROJECT_NAME            = 'msaproject'
        DOCKER_IMAGE_NAME              = 'msaproject/bond'
        DOCKER_REPO_NAME               = 'bond'
        DOCKER_IMAGE_URL               = 'harbor.dev.jtcsb.co.kr/msaproject/bond'
        DOCKER_REGISTRY_CREDENTIALS_ID = 'harbor-credentials'

        // ── 모노레포 내 빌드 경로 ─────────────────────────────────────
        BUILD_CONTEXT                  = 'bond'
    }

    stages {
        stage('Load and Run') {
            steps {
                script {
                    def core = load 'common/core.groovy'
                    core.checkout()

                    dir(env.BUILD_CONTEXT) {
                        core.build()
                        core.sonarAnalysis()
                        core.sonarAnalysisResult()
                        core.dockerBuild()
                    }
                    core.dockerPush()
//                     core.harborImageScan()
                    core.gitOpsDeploy()
                }
            }
        }
    }
}