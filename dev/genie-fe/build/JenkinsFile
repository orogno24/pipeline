pipeline {
    agent {
        kubernetes {
            label 'dind'
        }
    }

    environment {
        BUILD_TOOL = 'gradle'
        REDMINE_URL = 'http://redmine.cicd.svc.cluster.local'

        SONAR_HOST_URL = 'http://sonarqube-sonarqube.cicd.svc.cluster.local:9000'
        SONAR_PROJECT_KEY = 'genie-us-fe'
        SONAR_PROJECT_NAME = 'genie-us-fe'

        // ── Git 소스 ─────────────────────────────────────────────────
        GIT_URL = 'http://gitea-http:3000/afterloan/genie-us-fe.git'
        GIT_CREDENTIALS_ID = 'gitea-credentials'
        GIT_BRANCH = 'dev'

        // ── GitOps 레포 (ArgoCD) ──────────────────────────────────────
        GITOPS_URL = 'http://gitea-http:3000/Gitops/kustomize.git'
        GITOPS_PATH = 'gitea-http:3000/Gitops/kustomize.git'
        GITOPS_API_URL = 'http://gitea-http:3000/api/v1/repos/Gitops/kustomize'
        GITOPS_CREDENTIALS_ID = 'gitea-credentials'
        GITOPS_BRANCH = 'main'
        GITOPS_DIR = 'genie-us-fe/overlay/dev'
        GITOPS_CONTAINER_NAME = 'genie-us-fe'

        // ── Harbor 이미지 ─────────────────────────────────────────────
        DOCKER_REGISTRY_URL = 'harbor-core:80'
        DOCKER_REGISTRY_URL_OPS = 'harbor.jtchinae-bank.co.kr'
        DOCKER_PROJECT_NAME = 'jtcsb'
        DOCKER_IMAGE_NAME = 'jtcsb/genie-us-fe'
        DOCKER_REPO_NAME = 'genie-us-fe'
        DOCKER_IMAGE_URL = 'harbor.jtchinae-bank.co.kr/jtcsb/genie-us-fe'
        DOCKER_REGISTRY_CREDENTIALS_ID = 'harbor-jtcsb-credentials'

        // ── 모노레포 내 빌드 경로 ─────────────────────────────────────
        BUILD_CONTEXT = '.'

        // ── Redmine issue id 저장용 ──────────────────────────────────
        REDMINE_ISSUE_ID = ''
    }

    stages {
        stage('Webhook Info') {
            steps {
                echo "Webhook received"
                echo "ref = ${env.ref}"
                echo "after = ${env.after}"
            }
        }

        stage('Load and Run') {
            steps {
                script {
                    def core = load 'common/core.groovy'

                    // 1) 소스 체크아웃
                    core.checkout()

                    // 2) Jenkinsfile에서 직접 Redmine 이슈 생성
                    withCredentials([string(credentialsId: 'redmine-api-key', variable: 'REDMINE_API_KEY')]) {
                        def commitSha = sh(
                            script: 'git rev-parse HEAD',
                            returnStdout: true
                        ).trim()

                        def version = env.APP_VERSION ?: 'latest'
                        def subject = "[Jenkins] ${env.JOB_NAME} - ${env.GIT_BRANCH} - ${version}"
                        def description = """배포 상태: START

브랜치: ${env.GIT_BRANCH}
태그: ${version}
커밋: ${commitSha}
빌드 번호: ${env.BUILD_NUMBER}
빌드 URL: ${env.BUILD_URL ?: ''}
"""

                        writeFile file: 'redmine_issue.json', text: groovy.json.JsonOutput.toJson([
                            issue: [
                                project_id : 'jt-genie-lam',
                                subject    : subject,
                                description: description
                            ]
                        ])

                        env.REDMINE_ISSUE_ID = sh(
                            script: '''
                                set -e
                                RESPONSE=$(curl -sS -X POST "$REDMINE_URL/issues.json" \
                                  -H "X-Redmine-API-Key: $REDMINE_API_KEY" \
                                  -H "Content-Type: application/json" \
                                  --data @redmine_issue.json)

                                echo "Redmine create response: $RESPONSE" >&2

                                echo "$RESPONSE" \
                                  | grep -o '"id":[0-9]*' \
                                  | head -1 \
                                  | cut -d: -f2
                            ''',
                            returnStdout: true
                        ).trim()

                        echo "Jenkinsfile stored REDMINE_ISSUE_ID = ${env.REDMINE_ISSUE_ID}"

                        if (!env.REDMINE_ISSUE_ID?.trim()) {
                            error("Redmine 이슈 생성 실패 - issue id 추출 실패")
                        }
                    }

                    // 3) 파이프라인 시작 기록
                    core.updateRedmineIssue(
                        """[Pipeline] 시작
- Job: ${env.JOB_NAME}
- Build: #${env.BUILD_NUMBER}
- Branch: ${env.GIT_BRANCH}
- Version: ${env.APP_VERSION ?: 'unknown'}
- URL: ${env.BUILD_URL ?: ''}
""",
                        5
                    )

                    // 4) 기존 잘 되던 흐름 유지
                    dir(env.BUILD_CONTEXT) {
                        core.dockerBuild()
                    }
                    core.dockerPush()
                    core.gitOpsDeploy()
                }
            }
        }
    }

    post {
        success {
            script {
                if (env.REDMINE_ISSUE_ID?.trim()) {
                    withCredentials([string(credentialsId: 'redmine-api-key', variable: 'REDMINE_API_KEY')]) {
                        writeFile file: 'redmine_success.json', text: """{
  "issue": {
    "notes": "[Pipeline] 전체 성공\\n- Job: ${env.JOB_NAME}\\n- Build: #${env.BUILD_NUMBER}\\n- Branch: ${env.GIT_BRANCH}\\n- Version: ${env.APP_VERSION ?: 'unknown'}\\n- URL: ${env.BUILD_URL ?: ''}",
    "done_ratio": 100
  }
}"""
                        sh '''
                            curl -sS -X PUT "$REDMINE_URL/issues/$REDMINE_ISSUE_ID.json" \
                              -H "X-Redmine-API-Key: $REDMINE_API_KEY" \
                              -H "Content-Type: application/json" \
                              --data @redmine_success.json
                        '''
                    }
                }
            }
        }

        failure {
            script {
                if (env.REDMINE_ISSUE_ID?.trim()) {
                    withCredentials([string(credentialsId: 'redmine-api-key', variable: 'REDMINE_API_KEY')]) {
                        writeFile file: 'redmine_failure.json', text: """{
  "issue": {
    "notes": "[Pipeline] 전체 실패\\n- Job: ${env.JOB_NAME}\\n- Build: #${env.BUILD_NUMBER}\\n- Branch: ${env.GIT_BRANCH}\\n- Version: ${env.APP_VERSION ?: 'unknown'}\\n- URL: ${env.BUILD_URL ?: ''}",
    "done_ratio": 99
  }
}"""
                        sh '''
                            curl -sS -X PUT "$REDMINE_URL/issues/$REDMINE_ISSUE_ID.json" \
                              -H "X-Redmine-API-Key: $REDMINE_API_KEY" \
                              -H "Content-Type: application/json" \
                              --data @redmine_failure.json
                        '''
                    }
                }
            }
        }

        unstable {
            script {
                if (env.REDMINE_ISSUE_ID?.trim()) {
                    withCredentials([string(credentialsId: 'redmine-api-key', variable: 'REDMINE_API_KEY')]) {
                        writeFile file: 'redmine_unstable.json', text: """{
  "issue": {
    "notes": "[Pipeline] UNSTABLE\\n- Job: ${env.JOB_NAME}\\n- Build: #${env.BUILD_NUMBER}\\n- Branch: ${env.GIT_BRANCH}\\n- Version: ${env.APP_VERSION ?: 'unknown'}\\n- URL: ${env.BUILD_URL ?: ''}",
    "done_ratio": 99
  }
}"""
                        sh '''
                            curl -sS -X PUT "$REDMINE_URL/issues/$REDMINE_ISSUE_ID.json" \
                              -H "X-Redmine-API-Key: $REDMINE_API_KEY" \
                              -H "Content-Type: application/json" \
                              --data @redmine_unstable.json
                        '''
                    }
                }
            }
        }

        aborted {
            script {
                if (env.REDMINE_ISSUE_ID?.trim()) {
                    withCredentials([string(credentialsId: 'redmine-api-key', variable: 'REDMINE_API_KEY')]) {
                        writeFile file: 'redmine_aborted.json', text: """{
  "issue": {
    "notes": "[Pipeline] 중단됨\\n- Job: ${env.JOB_NAME}\\n- Build: #${env.BUILD_NUMBER}\\n- Branch: ${env.GIT_BRANCH}\\n- Version: ${env.APP_VERSION ?: 'unknown'}\\n- URL: ${env.BUILD_URL ?: ''}",
    "done_ratio": 99
  }
}"""
                        sh '''
                            curl -sS -X PUT "$REDMINE_URL/issues/$REDMINE_ISSUE_ID.json" \
                              -H "X-Redmine-API-Key: $REDMINE_API_KEY" \
                              -H "Content-Type: application/json" \
                              --data @redmine_aborted.json
                        '''
                    }
                }
            }
        }

        always {
            echo "Pipeline finished: ${currentBuild.currentResult}"
            echo "Redmine issue id: ${env.REDMINE_ISSUE_ID ?: 'N/A'}"
        }
    }
}