def core

pipeline {
    agent {
        kubernetes {
            label 'dind'
        }
    }

    environment {
        BUILD_TOOL = 'docker'

        // Git source
        GIT_URL = 'http://gitea-http:3000/it-department/genie-us-front.git'
        GIT_CREDENTIALS_ID = 'gitea-credentials'
        GIT_BRANCH = 'dev'

        // GitOps
        GITOPS_URL = 'http://gitea-http:3000/Gitops/kustomize.git'
        GITOPS_PATH = 'gitea-http:3000/Gitops/kustomize.git'
        GITOPS_API_URL = 'http://gitea-http:3000/api/v1/repos/Gitops/kustomize'
        GITOPS_CREDENTIALS_ID = 'gitea-credentials'
        GITOPS_BRANCH = 'main'
        GITOPS_DIR = 'genie-us-fe/overlay/dev'
        GITOPS_CONTAINER_NAME = 'genie-us-fe'

        // Harbor
        DOCKER_REGISTRY_URL = 'harbor-core:80'
        DOCKER_REGISTRY_URL_OPS = 'harbor.jtchinae-bank.co.kr'
        DOCKER_PROJECT_NAME = 'jtcsb'
        DOCKER_IMAGE_NAME = 'jtcsb/genie-us-fe'
        DOCKER_REPO_NAME = 'genie-us-fe'
        DOCKER_IMAGE_URL = 'harbor.jtchinae-bank.co.kr/jtcsb/genie-us-fe'
        DOCKER_REGISTRY_CREDENTIALS_ID = 'harbor-jtcsb-credentials'

        // checkout / build path
        SOURCE_DIR = 'source'
        BUILD_CONTEXT = 'source'

        // Redmine
        REDMINE_URL = 'http://redmine.cicd.svc.cluster.local'
        
        SKIP_BUILD = 'false'
    }

    stages {
        stage('Init') {
            steps {
                script {
                    core = load 'common/core.groovy'
                }
            }
        }

        stage('Webhook Info') {
            steps {
                echo "Webhook received"
                echo "ref = ${env.ref}"
                echo "before = ${env.before}"
                echo "after = ${env.after}"
                echo "repository = ${env.repository}"
                echo "pusher = ${env.pusher}"
            }
        }

        stage('Checkout') {
            steps {
                dir(env.SOURCE_DIR) {
                    script {
                        core.checkout()
                    }
                }
            }
        }

        stage('Create Redmine Issue') {
            steps {
                dir(env.SOURCE_DIR) {
                    script {
                        core.createOrUpdateStartIssue()
                    }
                }
            }
        }

        stage('Detect Changes') {
            steps {
                dir(env.SOURCE_DIR) {
                    script {
                        core.markStage('변경 파일 감지', '시작', 21)

                        if (!env.after?.trim() || env.after == 'null') {
                            echo "Webhook 변수가 없어 변경 파일 감지를 생략합니다. 수동 실행으로 간주합니다."
                            env.SKIP_BUILD = 'false'
                            core.updateRedmineIssue(
                                """[변경 파일 감지] webhook commit 정보 없음
- 수동 실행으로 간주
- SKIP_BUILD=false
""",
                                23
                            )
                            return
                        }

                        def changedFiles = ''

                        if (env.before?.trim() && env.before != 'null' && !env.before.startsWith('0000000')) {
                            changedFiles = sh(
                                script: "git diff --name-only ${env.before} ${env.after} || true",
                                returnStdout: true
                            ).trim()
                        } else {
                            changedFiles = sh(
                                script: "git diff-tree --no-commit-id --name-only -r ${env.after} || true",
                                returnStdout: true
                            ).trim()
                        }

                        echo "Changed files:\n${changedFiles}"

                        env.SKIP_BUILD = changedFiles ? 'false' : 'true'
                        echo "SKIP_BUILD = ${env.SKIP_BUILD}"

                        core.updateRedmineIssue(
                            """[변경 파일 감지] 성공
- Changed Files:
${changedFiles ?: '없음'}
- SKIP_BUILD: ${env.SKIP_BUILD}
""",
                            25
                        )
                    }
                }
            }
        }

        stage('Docker Build') {
            when {
                expression { env.SKIP_BUILD != 'true' }
            }
            steps {
                dir(env.BUILD_CONTEXT) {
                    script {
                        core.dockerBuild()
                    }
                }
            }
        }

        stage('Docker Push') {
            when {
                expression { env.SKIP_BUILD != 'true' }
            }
            steps {
                script {
                    core.dockerPush()
                }
            }
        }

        stage('GitOps Deploy') {
            when {
                expression { env.SKIP_BUILD != 'true' }
            }
            steps {
                script {
                    core.gitOpsDeploy()
                }
            }
        }

        stage('Skip Info') {
            when {
                expression { env.SKIP_BUILD == 'true' }
            }
            steps {
                script {
                    echo "변경 파일이 없어 프론트 파이프라인을 생략합니다."
                    core.updateRedmineIssue(
                        """[Pipeline] 변경 파일 없음
- 프론트 파이프라인 실행 생략
- Branch: ${env.GIT_BRANCH}
- Build: #${env.BUILD_NUMBER}
- URL: ${env.BUILD_URL ?: ''}
""",
                        100
                    )
                }
            }
        }
    }

    post {
        success {
            script {
                if (env.REDMINE_ISSUE_ID?.trim() && core != null) {
                    core.updateRedmineIssue(
                        """[Pipeline] 전체 성공
- Job: ${env.JOB_NAME}
- Build: #${env.BUILD_NUMBER}
- Branch: ${env.GIT_BRANCH}
- Version: ${env.APP_VERSION ?: 'unknown'}
- URL: ${env.BUILD_URL ?: ''}
""",
                        100
                    )
                }
            }
            echo "프론트 CI/CD 파이프라인 완료"
        }

        failure {
            script {
                if (env.REDMINE_ISSUE_ID?.trim() && core != null) {
                    core.updateRedmineIssue(
                        """[Pipeline] 전체 실패
- Job: ${env.JOB_NAME}
- Build: #${env.BUILD_NUMBER}
- Branch: ${env.GIT_BRANCH}
- Version: ${env.APP_VERSION ?: 'unknown'}
- URL: ${env.BUILD_URL ?: ''}
""",
                        0
                    )
                }
            }
            echo "프론트 CI/CD 파이프라인 실패"
        }
    }
}