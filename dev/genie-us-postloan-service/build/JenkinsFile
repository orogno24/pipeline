def core

pipeline {
    agent {
        kubernetes {
            label 'dind-gradle'
        }
    }

    environment {
        APP_NAME     = 'genie-us-postloan-service'        
    }

    stages {
        stage('Init') {
            steps {
                script {
                    core = load 'common/core.groovy'
                    core.initEnv()
                }
            }
        }

        stage('Webhook Info') {
            steps {
                echo "Webhook received"
                echo "ref = ${env.ref}"
                echo "before = ${env.before}"
                echo "after = ${env.after}"
            }
        }

        stage('Checkout') {
            steps {
                script {
                    core.checkout()
                    core.createOrUpdateStartIssue()
                }
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    core.detectChanges()
                }
            }
        }

        stage('Load and Run') {
            steps {
                script {
                    try {
                        if (env.SKIP_BUILD == 'true') {
                            echo "변경 파일이 없어 build/sonar/docker/push/deploy를 생략합니다."
                            core.updateRedmineIssue(
                                """[Pipeline] 변경 파일 없음
- build/sonar/docker/push/deploy 생략
- Branch: ${env.GIT_BRANCH}
- Build: #${env.BUILD_NUMBER}
- URL: ${env.BUILD_URL ?: ''}
""",
                                100
                            )
                            return
                        }

                        // 1. 빌드 및 품질 분석 (Gradle 환경)
                        container('gradle') {
                            dir(env.BUILD_CONTEXT) {
                                core.build()
                                core.sonarAnalysis()
                                core.sonarAnalysisResult()
                            }
                        }

                        // 2. 도커 이미지 빌드 및 푸시
                        dir(env.BUILD_CONTEXT) {
                            core.dockerBuild()
                        }
                        core.dockerPush()

                        // 3. GitOps 배포 설정 업데이트
                        core.gitOpsDeploy()

                    } catch (err) {
                        echo "Pipeline execution failed: ${err}"
                        throw err
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                if (core) {
                    core.updateRedminePost('성공', 100, 14)
                } else {
                    echo "core not loaded; skip post Redmine update"
                }
            }
        }

        failure {
            script {
                if (core) {
                    core.updateRedminePost('실패', null, 15)
                } else {
                    echo "core not loaded; skip post Redmine update"
                }
            }
        }
    }
}