def core

pipeline {
    agent {
        kubernetes {
            label 'dind-gradle'
        }
    }

    environment {
        APP_NAME     = 'genie-us-postloan-service'        
    }

    stages {
        stage('Init') {
            steps {
                script {
                    core = load 'common/core.groovy'
                    core.initEnv()
                }
            }
        }

        stage('Webhook Info') {
            steps {
                echo "Webhook received"
                echo "ref = ${env.ref}"
                echo "before = ${env.before}"
                echo "after = ${env.after}"
            }
        }

        stage('Checkout') {
            steps {
                script {
                    core.checkout()
                    core.createOrUpdateStartIssue()
                }
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    core.detectChanges()
                }
            }
        }

        stage('Load and Run') {
            steps {
                script {
                    core.runDevBuildFlow('gradle')
                }
            }
        }
    }

    post {
        success {
            script {
                if (core) {
                    core.finalizeDevPost(true)
                } else {
                    echo "core not loaded; skip post Redmine update"
                }
            }
        }

        failure {
            script {
                if (core) {
                    core.finalizeDevPost(false)
                } else {
                    echo "core not loaded; skip post Redmine update"
                }
            }
        }
    }
}